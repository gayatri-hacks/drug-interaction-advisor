# ============================================================
# Drug Interaction Advisor — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your API keys
# Never commit .env to version control

# ── LLM Backend (Optional) ───────────────────────────────────
# local works without a paid AI key. Choose: local, openai, groq
LLM_PROVIDER=local
OPENAI_API_KEY=sk-your-openai-key-here
GROQ_API_KEY=your-groq-key-here

# ── OpenFDA API (Free, no key required, but key gives higher rate limits) ────
# Get a free key at: https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=your-openfda-key-here

# ── Model Configuration ──────────────────────────────────────
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0
GROQ_MODEL=llama-3.1-70b-versatile

# ── App Settings ─────────────────────────────────────────────
APP_TITLE=Drug Interaction Advisor
FAISS_INDEX_PATH=faiss_store
LOG_LEVEL=INFO
