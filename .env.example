# Default, keyless mode. The app still makes live RxNorm/NLM and OpenFDA calls.
AI_PROVIDER=local
REQUEST_TIMEOUT_SECONDS=8
HTTP_MAX_RETRIES=2

# Optional OpenFDA key increases public rate limits.
OPENFDA_API_KEY=

# Optional LLMs: never initialized in local mode; never override deterministic flags.
# AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
